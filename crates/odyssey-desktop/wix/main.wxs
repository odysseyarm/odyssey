<?xml version="1.0" encoding="utf-8"?>
<!--
  The WiX template for the Odyssey installer, rendered by cargo-packager (Handlebars) and then
  compiled by WiX's candle. cargo-packager derives its own upgrade code from the binary name, so
  the code Windows knows this product by is written in below instead. Windows identifies an
  installed product by it: change it and an upgrade installs a second copy beside the first
  instead of replacing it, so it has to outlive every rename and every version.

  candle reads two environment variables the caller must set. cargo-packager clears the
  environment for WiX except names starting with CARGO_PACKAGER, hence the prefix:

    CARGO_PACKAGER_ODYSSEY_MSI_VARIANT   "online" or "full". Full carries the Orbbec camera SDK
                                         as an optional feature and asks for Orbbec's EULA;
                                         online carries nothing.
    CARGO_PACKAGER_ODYSSEY_ORBBEC_STAGE  Directory `cargo xtask desktop prepare-orbbec` filled
                                         (full only): EULA.rtf and the SDK files the fragment
                                         installs.

  Which variant is installed and whether offline mode is on are separate choices: neither
  variant turns offline mode on unless OFFLINE_MODE=1 is passed at install time.

  Run `cargo xtask desktop bundle online|full`, or see .github/workflows/desktop-release.yml.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
        Id="*"
        Name="{{product_name}}"
        UpgradeCode="B881AF96-4F5E-4BC7-99E7-F1C46F96C235"
        Language="1033"
        Codepage="1252"
        Version="{{version}}"
        Manufacturer="{{manufacturer}}">

        <Package
            Id="*"
            Keywords="Installer"
            Description="Odyssey PC application"
            Manufacturer="{{manufacturer}}"
            InstallScope="perMachine"
            Languages="1033"
            Compressed="yes"
            SummaryCodepage="1252" />

        <MajorUpgrade
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit."
            AllowSameVersionUpgrades="yes" />

        <MediaTemplate EmbedCab="yes" />

        {{#if icon_path}}
        <Icon Id="ProductIcon" SourceFile="{{icon_path}}" />
        <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
        {{/if}}

        <?if $(env.CARGO_PACKAGER_ODYSSEY_MSI_VARIANT) = "full" ?>
        <!-- The full installer offers Orbbec camera support as an optional feature, so it
             uses the feature tree, and its licence page is Orbbec's EULA (`cargo xtask desktop
             prepare-orbbec` writes it). -->
        <WixVariable Id="WixUILicenseRtf" Value="$(env.CARGO_PACKAGER_ODYSSEY_ORBBEC_STAGE)\EULA.rtf" />
        <UIRef Id="WixUI_FeatureTree" />
        <?else?>
        <UI>
            <UIRef Id="WixUI_InstallDir" />
            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2">1</Publish>
            <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">1</Publish>
        </UI>
        <?endif?>
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

        <!-- OFFLINE_MODE=1 turns Odyssey's offline mode on for the whole machine (it writes the
             HKLM value odyssey_hub_server::policy reads) and creates the firmware pack folder;
             deploy with `msiexec /i Odyssey.msi OFFLINE_MODE=1`. Off unless passed, in both
             variants: installing the full variant is not a request for offline mode. -->
        <Property Id="OFFLINE_MODE" Secure="yes" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLDIR" Name="{{product_name}}">
                    <Component Id="MainExecutable" Guid="*">
                        <File
                            Id="MainExe"
                            Source="{{app_exe_source}}"
                            KeyPath="yes" />
                    </Component>
                    <Component Id="OfflineModePolicy" Guid="*">
                        <Condition>OFFLINE_MODE = "1"</Condition>
                        <RegistryValue
                            Root="HKLM"
                            Key="SOFTWARE\{{manufacturer}}\{{product_name}}"
                            Name="OfflineMode"
                            Type="integer"
                            Value="1"
                            KeyPath="yes" />
                    </Component>
{{{resources}}}
                </Directory>
            </Directory>

            <!-- %ProgramData%\OdysseyArm\Odyssey\firmware-pack, where offline mode reads firmware. -->
            <Directory Id="CommonAppDataFolder">
                <Directory Id="OdysseyDataPublisher" Name="{{manufacturer}}">
                    <Directory Id="OdysseyDataProduct" Name="{{product_name}}">
                        <Directory Id="FirmwarePackFolder" Name="firmware-pack">
                            <!-- A folder as the key path needs an explicit GUID; never change it. -->
                            <Component Id="FirmwarePackFolderComponent" Guid="3F0B7A52-8C1D-4E7B-A6D5-9B2E41C70F18">
                                <Condition>OFFLINE_MODE = "1"</Condition>
                                <CreateFolder />
                            </Component>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>

            <Directory Id="ProgramMenuFolder">
                <Directory Id="ProgramMenuSubfolder" Name="{{product_name}}">
                    <Component Id="StartMenuShortcut" Guid="*">
                        <Shortcut
                            Id="ApplicationShortcut"
                            Name="{{product_name}}"
                            Description="Odyssey PC application"
                            Icon="ProductIcon"
                            Target="[#MainExe]"
                            WorkingDirectory="INSTALLDIR" />
                        <RemoveFolder Id="RemoveProgramMenuSubfolder" On="uninstall" />
                        <RegistryValue
                            Root="HKCU"
                            Key="Software\{{manufacturer}}\{{product_name}}"
                            Name="installed"
                            Type="integer"
                            Value="1"
                            KeyPath="yes" />
                    </Component>
                </Directory>
            </Directory>

            <Directory Id="DesktopFolder">
                <Component Id="DesktopShortcut" Guid="*">
                    <Shortcut
                        Id="DesktopShortcut"
                        Name="{{product_name}}"
                        Description="Odyssey PC application"
                        Icon="ProductIcon"
                        Target="[#MainExe]"
                        WorkingDirectory="INSTALLDIR" />
                    <RegistryValue
                        Root="HKCU"
                        Key="Software\{{manufacturer}}\{{product_name}}"
                        Name="desktop_shortcut"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
                </Component>
            </Directory>
        </Directory>

        <Feature
            Id="MainFeature"
            Title="{{product_name}}"
            Level="1"
            Display="expand"
            ConfigurableDirectory="INSTALLDIR"
            Absent="disallow">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="StartMenuShortcut" />
            <ComponentRef Id="DesktopShortcut" />
            <ComponentRef Id="OfflineModePolicy" />
            <ComponentRef Id="FirmwarePackFolderComponent" />
            {{#each resource_file_ids}}
            <ComponentRef Id="{{this}}" />
            {{/each}}
            {{#each component_group_refs}}
            <ComponentGroupRef Id="{{this}}" />
            {{/each}}
            {{#each component_refs}}
            <ComponentRef Id="{{this}}" />
            {{/each}}
            {{#each feature_group_refs}}
            <FeatureGroupRef Id="{{this}}" />
            {{/each}}
            {{#each feature_refs}}
            <FeatureRef Id="{{this}}" />
            {{/each}}
            {{#each merge_refs}}
            <MergeRef Id="{{this}}" />
            {{/each}}
        </Feature>
    </Product>
</Wix>
