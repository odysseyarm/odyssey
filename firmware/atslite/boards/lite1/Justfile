output_dir := "build"
bootloader_dist := "dist-bootloader"
netcore_dist := "dist-netcore"
net_core := "net-core"

# Default recipe - show available commands
default:
    @just --list

# Clean build artifacts
clean:
    rm -rf {{output_dir}} target bootloader/target stage1-bootloader/target netcore-bootloader/target net-core/target
    cargo clean
    cd bootloader && cargo clean
    cd stage1-bootloader && cargo clean
    cd netcore-bootloader && cargo clean
    cd net-core && cargo clean

# Build lite1 application for bank A (default)
build-app:
    cargo build --release --target thumbv8m.main-none-eabihf

# Build lite1 application for bank A
build-app-a:
    APP_BANK=bank_a cargo build --release --target thumbv8m.main-none-eabihf --target-dir target-bank-a

# Build lite1 application for bank B
build-app-b:
    APP_BANK=bank_b cargo build --release --target thumbv8m.main-none-eabihf --target-dir target-bank-b

# Build lite1 stage1 bootloader
build-stage1:
    cd stage1-bootloader && cargo build --release --target thumbv8m.main-none-eabihf

# Build lite1 stage2 bootloader (DFU)
build-bootloader:
    cd bootloader && cargo build --release --target thumbv8m.main-none-eabihf --features defmt

# Build the stage2 bootloader artifacts a bootloader release publishes.
# OBJCOPY overrides the tool name on machines that call it something else.
dist-bootloader: build-bootloader
    #!/usr/bin/env bash
    set -euo pipefail
    OBJCOPY=${OBJCOPY:-llvm-objcopy}
    elf=bootloader/target/thumbv8m.main-none-eabihf/release/lite1-bootloader
    rm -rf {{bootloader_dist}}
    mkdir -p {{bootloader_dist}}
    cp "$elf" {{bootloader_dist}}/stage2-bootloader.elf
    "$OBJCOPY" -O binary "$elf" {{bootloader_dist}}/stage2-bootloader.bin
    "$OBJCOPY" -O ihex "$elf" {{bootloader_dist}}/stage2-bootloader.hex
    ls -l {{bootloader_dist}}

# Publish the stage2 bootloader as its own GitHub release, atslite1-bootloader-v<release>.
# Set DRY_RUN=1 to run every check and stop before publishing.
#
# The release is created as a draft and published last, so a tag never exists
# without its assets; the bootloader-release workflow skips a tag that already
# has a release, so the two ways of publishing cannot overwrite each other.
release-bootloader: dist-bootloader
    #!/usr/bin/env bash
    set -euo pipefail
    RELEASE=$(sed -n 's/^macro_rules! release { () => { \([0-9][0-9]*\) }; }$/\1/p' bootloader/src/main.rs)
    if [ -z "$RELEASE" ]; then
        echo "Error: no release counter found in bootloader/src/main.rs"
        exit 1
    fi
    TAG="atslite1-bootloader-v$RELEASE"
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
        echo "Error: uncommitted changes; the release must be built from a commit."
        exit 1
    fi
    COMMIT=$(git rev-parse HEAD)
    if ! git branch -r --contains "$COMMIT" | grep -q 'origin/master'; then
        echo "Error: $COMMIT is not on origin/master. Push it first."
        exit 1
    fi
    if gh release view "$TAG" >/dev/null 2>&1; then
        echo "Error: release $TAG already exists. Raise the counter in bootloader/src/main.rs."
        exit 1
    fi
    BCD=$(printf '0x%04X' $((0xF000 | RELEASE)))
    NOTES="ATS Lite 1 stage2 bootloader, release $RELEASE (bcdDevice $BCD). Installed by the desktop updater when a firmware release names this release. Do not delete."
    if [ "${DRY_RUN:-}" = 1 ]; then
        echo "Dry run: would publish $TAG from $COMMIT with:"
        ls {{bootloader_dist}}
        exit 0
    fi
    gh release create "$TAG" --draft --target "$COMMIT" \
        --title "ATS Lite 1 bootloader release $RELEASE" --notes "$NOTES" \
        {{bootloader_dist}}/stage2-bootloader.bin {{bootloader_dist}}/stage2-bootloader.hex {{bootloader_dist}}/stage2-bootloader.elf
    gh release edit "$TAG" --draft=false
    echo "Published $TAG"

# Build lite1 net-core
build-net:
    cd {{net_core}} && cargo build --release

# Build the net-core artifacts a net-core release publishes.
# OBJCOPY overrides the tool name on machines that call it something else.
dist-netcore: build-net
    #!/usr/bin/env bash
    set -euo pipefail
    OBJCOPY=${OBJCOPY:-llvm-objcopy}
    elf={{net_core}}/target/thumbv8m.main-none-eabi/release/lite1-net-core
    rm -rf {{netcore_dist}}
    mkdir -p {{netcore_dist}}
    cp "$elf" {{netcore_dist}}/net-core.elf
    "$OBJCOPY" -O binary "$elf" {{netcore_dist}}/net-core.bin
    "$OBJCOPY" -O ihex "$elf" {{netcore_dist}}/net-core.hex
    ls -l {{netcore_dist}}

# Publish the net core as its own GitHub release, atslite1-netcore-v<release>.
# Set DRY_RUN=1 to run every check and stop before publishing.
#
# The release is created as a draft and published last, so a tag never exists
# without its assets; the netcore-release workflow skips a tag that already
# has a release, so the two ways of publishing cannot overwrite each other.
release-netcore: dist-netcore
    #!/usr/bin/env bash
    set -euo pipefail
    RELEASE=$(sed -n 's/^macro_rules! release { () => { \([0-9][0-9]*\) }; }$/\1/p' {{net_core}}/src/main.rs)
    if [ -z "$RELEASE" ]; then
        echo "Error: no release counter found in {{net_core}}/src/main.rs"
        exit 1
    fi
    TAG="atslite1-netcore-v$RELEASE"
    if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
        echo "Error: uncommitted changes; the release must be built from a commit."
        exit 1
    fi
    COMMIT=$(git rev-parse HEAD)
    if ! git branch -r --contains "$COMMIT" | grep -q 'origin/master'; then
        echo "Error: $COMMIT is not on origin/master. Push it first."
        exit 1
    fi
    if gh release view "$TAG" >/dev/null 2>&1; then
        echo "Error: release $TAG already exists. Raise the counter in {{net_core}}/src/main.rs."
        exit 1
    fi
    NOTES="ATS Lite 1 net core (BLE controller) firmware, release $RELEASE. Installed by the desktop updater when a firmware release names this release. Do not delete."
    if [ "${DRY_RUN:-}" = 1 ]; then
        echo "Dry run: would publish $TAG from $COMMIT with:"
        ls {{netcore_dist}}
        exit 0
    fi
    gh release create "$TAG" --draft --target "$COMMIT" \
        --title "ATS Lite 1 net-core release $RELEASE" --notes "$NOTES" \
        {{netcore_dist}}/net-core.bin {{netcore_dist}}/net-core.hex {{netcore_dist}}/net-core.elf
    gh release edit "$TAG" --draft=false
    echo "Published $TAG"

# Build lite1 netcore bootloader
build-netcore-bootloader:
    cd netcore-bootloader && cargo build --release --target thumbv8m.main-none-eabi

# Build complete lite1 firmware with both banks
build: build-stage1 build-app-a build-app-b build-bootloader build-netcore-bootloader build-net
    mkdir -p {{output_dir}}
    cp stage1-bootloader/target/thumbv8m.main-none-eabihf/release/lite1-stage1-bootloader {{output_dir}}/stage1-bootloader.elf
    cp target-bank-a/thumbv8m.main-none-eabihf/release/app {{output_dir}}/app-a.elf
    cp target-bank-b/thumbv8m.main-none-eabihf/release/app {{output_dir}}/app-b.elf
    cp bootloader/target/thumbv8m.main-none-eabihf/release/lite1-bootloader {{output_dir}}/stage2-bootloader.elf
    cp netcore-bootloader/target/thumbv8m.main-none-eabi/release/lite1-netcore-bootloader {{output_dir}}/netcore-bootloader.elf
    cp {{net_core}}/target/thumbv8m.main-none-eabi/release/lite1-net-core {{output_dir}}/net-core.elf
    llvm-objcopy -O ihex {{output_dir}}/stage1-bootloader.elf {{output_dir}}/stage1-bootloader.hex
    llvm-objcopy -O ihex {{output_dir}}/app-a.elf {{output_dir}}/app-a.hex
    llvm-objcopy -O ihex {{output_dir}}/app-b.elf {{output_dir}}/app-b.hex
    llvm-objcopy -O ihex {{output_dir}}/stage2-bootloader.elf {{output_dir}}/stage2-bootloader.hex
    llvm-objcopy -O ihex {{output_dir}}/netcore-bootloader.elf {{output_dir}}/netcore-bootloader.hex
    llvm-objcopy -O ihex {{output_dir}}/net-core.elf {{output_dir}}/net-core.hex
    llvm-objcopy -O binary {{output_dir}}/app-a.elf {{output_dir}}/app-a.bin
    llvm-objcopy -O binary {{output_dir}}/app-b.elf {{output_dir}}/app-b.bin
    llvm-objcopy -O binary {{output_dir}}/stage2-bootloader.elf {{output_dir}}/stage2-bootloader.bin
    llvm-objcopy -O binary {{output_dir}}/net-core.elf {{output_dir}}/net-core.bin
    mergehex -o {{output_dir}}/merged.hex -m {{output_dir}}/stage1-bootloader.hex {{output_dir}}/stage2-bootloader.hex {{output_dir}}/app-a.hex {{output_dir}}/app-b.hex {{output_dir}}/netcore-bootloader.hex {{output_dir}}/net-core.hex

# Build complete dual-bank firmware with both app banks and DFU binaries
build-dual-bank: build-stage1 build-app-a build-app-b build-bootloader build-net
    mkdir -p {{output_dir}}
    cp stage1-bootloader/target/thumbv8m.main-none-eabihf/release/lite1-stage1-bootloader {{output_dir}}/stage1-bootloader.elf
    cp target-bank-a/thumbv8m.main-none-eabihf/release/app {{output_dir}}/app-a.elf
    cp target-bank-b/thumbv8m.main-none-eabihf/release/app {{output_dir}}/app-b.elf
    cp bootloader/target/thumbv8m.main-none-eabihf/release/lite1-bootloader {{output_dir}}/stage2-bootloader.elf
    cp {{net_core}}/target/thumbv8m.main-none-eabi/release/lite1-net-core {{output_dir}}/net-core.elf
    llvm-objcopy -O ihex {{output_dir}}/stage1-bootloader.elf {{output_dir}}/stage1-bootloader.hex
    llvm-objcopy -O ihex {{output_dir}}/app-a.elf {{output_dir}}/app-a.hex
    llvm-objcopy -O ihex {{output_dir}}/app-b.elf {{output_dir}}/app-b.hex
    llvm-objcopy -O ihex {{output_dir}}/stage2-bootloader.elf {{output_dir}}/stage2-bootloader.hex
    llvm-objcopy -O ihex {{output_dir}}/net-core.elf {{output_dir}}/net-core.hex
    llvm-objcopy -O binary {{output_dir}}/app-a.elf {{output_dir}}/app-a.bin
    llvm-objcopy -O binary {{output_dir}}/app-b.elf {{output_dir}}/app-b.bin
    llvm-objcopy -O binary {{output_dir}}/net-core.elf {{output_dir}}/net-core.bin
    mergehex -o {{output_dir}}/merged-dual.hex -m {{output_dir}}/stage1-bootloader.hex {{output_dir}}/stage2-bootloader.hex {{output_dir}}/app-a.hex {{output_dir}}/app-b.hex {{output_dir}}/net-core.hex

# Flash lite1 firmware
flash: build
    nrfjprog --program {{output_dir}}/netcore-bootloader.hex --coprocessor CP_NETWORK --sectorerase --verify
    nrfjprog --program {{output_dir}}/net-core.hex --coprocessor CP_NETWORK --sectorerase --verify
    nrfjprog --program {{output_dir}}/stage1-bootloader.hex --sectorerase --verify
    nrfjprog --program {{output_dir}}/stage2-bootloader.hex --sectorerase --verify
    nrfjprog --program {{output_dir}}/app-a.hex --sectorerase --verify
    nrfjprog --program {{output_dir}}/app-b.hex --sectorerase --verify
    # Clear bootloader state pages so boot state starts erased (0xFFFFFFFF)
    nrfjprog --erasepage 0xF9000
    nrfjprog --erasepage 0xFA000
    nrfjprog --reset

# Flash with chip erase
flash-chiperase: build
    nrfjprog --program {{output_dir}}/netcore-bootloader.hex --coprocessor CP_NETWORK --sectorerase --verify
    nrfjprog --program {{output_dir}}/net-core.hex --coprocessor CP_NETWORK --sectorerase --verify
    nrfjprog --chiperase --verify
    nrfjprog --program {{output_dir}}/stage1-bootloader.hex --verify
    nrfjprog --program {{output_dir}}/stage2-bootloader.hex --verify
    nrfjprog --program {{output_dir}}/app-a.hex --verify
    nrfjprog --program {{output_dir}}/app-b.hex --verify
    nrfjprog --erasepage 0xFC000
    nrfjprog --erasepage 0xFD000
    nrfjprog --reset

# Flash with recover
flash-recover: build
    nrfjprog --recover
    nrfjprog --program {{output_dir}}/netcore-bootloader.hex --coprocessor CP_NETWORK --sectorerase --verify
    nrfjprog --program {{output_dir}}/net-core.hex --coprocessor CP_NETWORK --sectorerase --verify
    nrfjprog --program {{output_dir}}/stage1-bootloader.hex --sectorerase --verify
    nrfjprog --program {{output_dir}}/stage2-bootloader.hex --sectorerase --verify
    nrfjprog --program {{output_dir}}/app-a.hex --sectorerase --verify
    nrfjprog --program {{output_dir}}/app-b.hex --sectorerase --verify
    nrfjprog --erasepage 0xFC000
    nrfjprog --erasepage 0xFD000
    nrfjprog --reset

# Flash dual-bank with chip erase
flash-dual-chiperase: build-dual-bank
    nrfjprog --program {{output_dir}}/net-core.hex --coprocessor CP_NETWORK --sectorerase --verify
    nrfjprog --chiperase --verify
    nrfjprog --program {{output_dir}}/stage1-bootloader.hex --verify
    nrfjprog --program {{output_dir}}/stage2-bootloader.hex --verify
    nrfjprog --program {{output_dir}}/app-a.hex --verify
    nrfjprog --program {{output_dir}}/app-b.hex --verify
    nrfjprog --erasepage 0xFC000
    nrfjprog --erasepage 0xFD000
    nrfjprog --reset

# Flash dual-bank with recover
flash-dual-recover: build-dual-bank
    nrfjprog --recover
    nrfjprog --program {{output_dir}}/net-core.hex --coprocessor CP_NETWORK --sectorerase --verify
    nrfjprog --program {{output_dir}}/stage1-bootloader.hex --sectorerase --verify
    nrfjprog --program {{output_dir}}/stage2-bootloader.hex --sectorerase --verify
    nrfjprog --program {{output_dir}}/app-a.hex --sectorerase --verify
    nrfjprog --program {{output_dir}}/app-b.hex --sectorerase --verify
    nrfjprog --erasepage 0xFC000
    nrfjprog --erasepage 0xFD000
    nrfjprog --reset

# Flash application only
flash-app: build-app
    mkdir -p {{output_dir}}
    cp target/thumbv8m.main-none-eabihf/release/app {{output_dir}}/app.elf
    llvm-objcopy -O ihex {{output_dir}}/app.elf {{output_dir}}/app.hex
    nrfjprog --program {{output_dir}}/app.hex --sectorerase --verify --reset

# Attach probe-rs to app core
attach-app-a:
    probe-rs attach --chip nRF5340_xxAA {{output_dir}}/app-a.elf

attach-app-b:
    probe-rs attach --chip nRF5340_xxAA {{output_dir}}/app-b.elf

# Attach probe-rs to network core
attach-net:
    probe-rs attach --chip nRF5340_xxAA --rtt-scan-memory {{output_dir}}/net-core.elf

# Attach to app core bootloader (net core unlocked for debugging)
attach-bootloader:
    probe-rs attach --chip nRF5340_xxAA {{output_dir}}/stage2-bootloader.elf

# Attach probe-rs to network core bootloader
attach-net-bootloader:
    probe-rs attach --chip nRF5340_xxAA --rtt-scan-memory netcore-bootloader/target/thumbv8m.main-none-eabi/release/lite1-netcore-bootloader

# Reset device
reset:
    nrfjprog --reset

# Check all components
check:
    cargo check
    cd stage1-bootloader && cargo check
    cd bootloader && cargo check
    cd netcore-bootloader && cargo check
    cd net-core && cargo check

# Generate a release entry in manifests/releases.alpha.json from current build.
# requires_bootloader and requires_netcore are the lowest bootloader and net-core
# releases this application can run on, 0 for none. min_desktop is the oldest
# Odyssey Desktop it is required and tested with, which is not automatically the
# desktop shipping alongside it.
# None has a default: leaving one out would silently mean "any".
gen-release requires_bootloader requires_netcore min_desktop:
    #!/usr/bin/env bash
    set -euo pipefail

    VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*= "\(.*\)"/\1/')
    MANIFEST="../../../manifests/releases.alpha.json"
    BUILD_DIR="{{output_dir}}"

    # Check that build files exist. The bootloader and net core are not among
    # them: they are released on their own and pinned from those releases below.
    for f in app-a.bin app-b.bin; do
        if [ ! -f "$BUILD_DIR/$f" ]; then
            echo "Error: $BUILD_DIR/$f not found. Run 'just build' first."
            exit 1
        fi
    done

    # Compute sha256 and size for each file
    APP_A_SHA=$(sha256sum "$BUILD_DIR/app-a.bin" | cut -d' ' -f1)
    APP_A_SIZE=$(stat -c%s "$BUILD_DIR/app-a.bin" 2>/dev/null || stat -f%z "$BUILD_DIR/app-a.bin")

    APP_B_SHA=$(sha256sum "$BUILD_DIR/app-b.bin" | cut -d' ' -f1)
    APP_B_SIZE=$(stat -c%s "$BUILD_DIR/app-b.bin" 2>/dev/null || stat -f%z "$BUILD_DIR/app-b.bin")

    # The net core is versioned on its own too, by the counter in its source,
    # and hashed from its published asset for the same reason as the bootloader.
    NET_CORE_RELEASE=$(sed -n 's/^macro_rules! release { () => { \([0-9][0-9]*\) }; }$/\1/p' net-core/src/main.rs)
    if [ -z "$NET_CORE_RELEASE" ]; then
        echo "Error: no release counter found in net-core/src/main.rs"
        exit 1
    fi
    NET_CORE_TAG="atslite1-netcore-v$NET_CORE_RELEASE"
    NET_CORE_BIN=$(mktemp)
    STAGE2=$(mktemp)
    trap 'rm -f "$STAGE2" "$NET_CORE_BIN"' EXIT
    if ! curl -fsSL "${RELEASES_BASE_URL:-https://github.com/odysseyarm/odyssey/releases/download}/$NET_CORE_TAG/net-core.bin" -o "$NET_CORE_BIN"; then
        echo "Error: no published release $NET_CORE_TAG. Run 'just release-netcore' first."
        exit 1
    fi
    NET_CORE_SHA=$(sha256sum "$NET_CORE_BIN" | cut -d' ' -f1)
    NET_CORE_SIZE=$(stat -c%s "$NET_CORE_BIN" 2>/dev/null || stat -f%z "$NET_CORE_BIN")

    # The bootloader is versioned on its own, by the counter in its source, and
    # released on its own. Hash the published asset rather than a local build:
    # a release built elsewhere is not bit-identical, and the manifest has to
    # describe the bytes devices will actually download.
    BOOTLOADER_RELEASE=$(sed -n 's/^macro_rules! release { () => { \([0-9][0-9]*\) }; }$/\1/p' bootloader/src/main.rs)
    if [ -z "$BOOTLOADER_RELEASE" ]; then
        echo "Error: no release counter found in bootloader/src/main.rs"
        exit 1
    fi
    BOOTLOADER_TAG="atslite1-bootloader-v$BOOTLOADER_RELEASE"
    if ! curl -fsSL "${RELEASES_BASE_URL:-https://github.com/odysseyarm/odyssey/releases/download}/$BOOTLOADER_TAG/stage2-bootloader.bin" -o "$STAGE2"; then
        echo "Error: no published release $BOOTLOADER_TAG. Run 'just release-bootloader' first."
        exit 1
    fi
    BOOTLOADER_SHA=$(sha256sum "$STAGE2" | cut -d' ' -f1)
    BOOTLOADER_SIZE=$(stat -c%s "$STAGE2" 2>/dev/null || stat -f%z "$STAGE2")
    REQUIRES_BOOTLOADER={{requires_bootloader}}
    REQUIRES_NETCORE={{requires_netcore}}
    if ! [[ "$REQUIRES_BOOTLOADER" =~ ^[0-9]+$ ]]; then
        echo "Error: requires_bootloader must be an integer, got '$REQUIRES_BOOTLOADER'."
        exit 1
    fi
    MIN_DESKTOP={{min_desktop}}
    if ! [[ "$MIN_DESKTOP" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "Error: min_desktop must be a version like 0.6.0, got '$MIN_DESKTOP'."
        exit 1
    fi
    if [ "$REQUIRES_BOOTLOADER" -gt "$BOOTLOADER_RELEASE" ]; then
        echo "Error: requires_bootloader $REQUIRES_BOOTLOADER is above the bootloader being published ($BOOTLOADER_RELEASE)."
        exit 1
    fi
    if ! [[ "$REQUIRES_NETCORE" =~ ^[0-9]+$ ]]; then
        echo "Error: requires_netcore must be an integer, got '$REQUIRES_NETCORE'."
        exit 1
    fi
    if [ "$REQUIRES_NETCORE" -gt "$NET_CORE_RELEASE" ]; then
        echo "Error: requires_netcore $REQUIRES_NETCORE is above the net core being published ($NET_CORE_RELEASE)."
        exit 1
    fi
    # The counter is baked into the image, so a hash and a counter identify each
    # other. A changed image under an unraised counter would never reach devices
    # already reporting that counter; one counter on two images, or one image
    # under two counters, means the manifest and the build disagree.
    BOOTLOADERS='.devices.atslite1.firmwares[].files["stage2-bootloader"]'
    SHA_RELEASES=$(jq -r --arg sha "$BOOTLOADER_SHA" "[$BOOTLOADERS | select(.sha256 == \$sha) | .release // 0] | unique | map(tostring) | join(\",\")" "$MANIFEST")
    COUNTER_OTHER_IMAGES=$(jq -r --arg sha "$BOOTLOADER_SHA" --argjson r "$BOOTLOADER_RELEASE" "[$BOOTLOADERS | select(.release == \$r and .sha256 != \$sha)] | length" "$MANIFEST")
    NEWEST_RELEASE=$(jq -r "[$BOOTLOADERS.release // 0] | max // 0" "$MANIFEST")
    if [ -n "$SHA_RELEASES" ] && [ "$SHA_RELEASES" != "$BOOTLOADER_RELEASE" ]; then
        echo "Error: this bootloader image is already published as release $SHA_RELEASES but its counter says $BOOTLOADER_RELEASE."
        exit 1
    fi
    if [ "$COUNTER_OTHER_IMAGES" != 0 ]; then
        echo "Error: release $BOOTLOADER_RELEASE is already published for a different bootloader image. Raise the counter in bootloader/src/main.rs."
        exit 1
    fi
    if [ -z "$SHA_RELEASES" ] && [ "$BOOTLOADER_RELEASE" -le "$NEWEST_RELEASE" ]; then
        echo "Error: the bootloader image changed but its release counter ($BOOTLOADER_RELEASE) is not above the newest published ($NEWEST_RELEASE)."
        exit 1
    fi
    # Same guards for the net core, whose counter is likewise baked into the
    # image. Entries that predate the counter have no release and count as 0.
    NETCORES='.devices.atslite1.firmwares[].files["net-core"]'
    NC_SHA_RELEASES=$(jq -r --arg sha "$NET_CORE_SHA" "[$NETCORES | select(.sha256 == \$sha) | .release // 0] | unique | map(tostring) | join(\",\")" "$MANIFEST")
    NC_COUNTER_OTHER_IMAGES=$(jq -r --arg sha "$NET_CORE_SHA" --argjson r "$NET_CORE_RELEASE" "[$NETCORES | select(.release == \$r and .sha256 != \$sha)] | length" "$MANIFEST")
    NC_NEWEST_RELEASE=$(jq -r "[$NETCORES.release // 0] | max // 0" "$MANIFEST")
    if [ -n "$NC_SHA_RELEASES" ] && [ "$NC_SHA_RELEASES" != "$NET_CORE_RELEASE" ]; then
        echo "Error: this net-core image is already published as release $NC_SHA_RELEASES but its counter says $NET_CORE_RELEASE."
        exit 1
    fi
    if [ "$NC_COUNTER_OTHER_IMAGES" != 0 ]; then
        echo "Error: release $NET_CORE_RELEASE is already published for a different net-core image. Raise the counter in net-core/src/main.rs."
        exit 1
    fi
    if [ -z "$NC_SHA_RELEASES" ] && [ "$NET_CORE_RELEASE" -le "$NC_NEWEST_RELEASE" ]; then
        echo "Error: the net-core image changed but its release counter ($NET_CORE_RELEASE) is not above the newest published ($NC_NEWEST_RELEASE)."
        exit 1
    fi

    TODAY=$(date +%Y-%m-%d)

    # Create the new firmware entry JSON
    NEW_ENTRY=$(cat <<EOF
    {
      "version": "$VERSION",
      "requires_bootloader": $REQUIRES_BOOTLOADER,
      "requires_netcore": $REQUIRES_NETCORE,
      "min_desktop": "$MIN_DESKTOP",
      "files": {
        "app-a": {
          "sha256": "$APP_A_SHA",
          "size": $APP_A_SIZE
        },
        "app-b": {
          "sha256": "$APP_B_SHA",
          "size": $APP_B_SIZE
        },
        "net-core": {
          "sha256": "$NET_CORE_SHA",
          "size": $NET_CORE_SIZE,
          "release": $NET_CORE_RELEASE
        },
        "stage2-bootloader": {
          "sha256": "$BOOTLOADER_SHA",
          "size": $BOOTLOADER_SIZE,
          "release": $BOOTLOADER_RELEASE
        }
      },
      "released": "$TODAY"
    }
    EOF
    )

    # Use jq to prepend the new entry to the firmwares array
    jq --argjson entry "$NEW_ENTRY" '.devices.atslite1.firmwares = [$entry] + .devices.atslite1.firmwares' "$MANIFEST" > "$MANIFEST.tmp"
    mv "$MANIFEST.tmp" "$MANIFEST"

    echo "Added release $VERSION to $MANIFEST"
    echo "  app-a: $APP_A_SHA ($APP_A_SIZE bytes)"
    echo "  app-b: $APP_B_SHA ($APP_B_SIZE bytes)"
    echo "  net-core: $NET_CORE_SHA ($NET_CORE_SIZE bytes, release $NET_CORE_RELEASE)"
    echo "  stage2-bootloader: $BOOTLOADER_SHA ($BOOTLOADER_SIZE bytes)"
